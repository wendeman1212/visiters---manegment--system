APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Must be reachable by OTHER devices when QR codes are scanned — use the
# server's LAN IPv4 in development (e.g. http://192.168.1.100:8000) and the
# real HTTPS domain in production (https://your-domain.com). Never localhost.
APP_URL=http://localhost:8000

# QR code URL overrides (optional, see config/qr.php).
# QR_BASE_URL=https://vms.example.com
# QR_LAN_IP=192.168.1.100
# QR_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── TWILIO SMS (optional env fallback) ─────────────────────────
# Credentials are normally entered in Admin > System & Integrations >
# SMS Gateway Configuration and stored in the system_integrations table.
# These env values are only used as a fallback when the database gateway
# is not configured. Set SMS_ENABLED=true to use them.
# SMS_ENABLED=false
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_WEBHOOK_URL=

# ── SMSEthiopia SMS (optional env fallback) ─────────────────────
# Used when the database gateway selects the smsethiopia provider but no
# API key is stored. Prefer entering the key in the Admin UI.
# SMSETHIOPIA_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
